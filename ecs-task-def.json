{
  "family": "strapi-app-jushline",
  "networkMode": "awsvpc",
  "executionRoleArn": "arn:aws:iam::884740154069:role/strapi-app-jushline-ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::884740154069:role/strapi-app-jushline-ecsTaskExecutionRole",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024",
  "containerDefinitions": [
    {
      "name": "strapi-app-jushline",
      "image": "123456789012.dkr.ecr.ap-south-1.amazonaws.com/strapi-repo:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 1337,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "API_TOKEN_SALT",
          "value": "somerandomsalt"
        },
        {
          "name": "APP_KEYS",
          "value": "key1,key2,key3,key4"
        },
        {
          "name": "PORT",
          "value": "1337"
        },
        {
          "name": "ADMIN_JWT_SECRET",
          "value": "somesecretjwt"
        },
        {
          "name": "HOST",
          "value": "0.0.0.0"
        },
        {
          "name": "TRANSFER_TOKEN_SALT",
          "value": "transfersecret"
        },
        {
          "name": "ENCRYPTION_KEY",
          "value": "encryptionsecret"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/strapi-app-jushline",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "strapi-app-jushline"
        }
      }
    }
  ]
}
